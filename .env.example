# ─────────────────────────────────────────────────────────────────────────────
#  ENTREGA SUA LOJA — variáveis de ambiente
#  Onde: Vercel → projeto entrega-sualoja (NÃO na LP sualoja) → Settings → Environment Variables
#        (ou `vercel env add NOME production` na pasta do projeto).
#  NENHUM valor vai para o código nem para o chat.
# ─────────────────────────────────────────────────────────────────────────────

# Banco (Upstash Redis via Vercel Marketplace). NÃO digite: ao conectar o
# banco ao projeto em Storage, a Vercel cria estas duas sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Webhook da Korvex. Um segredo NOVO, longo, só deste projeto (não reaproveite
# o da LP). Vai também na URL do webhook no painel da Korvex, no ?k=.
KORVEX_WEBHOOK_SECRET=

# Resend.
RESEND_API_KEY=
# Remetente com DOMÍNIO VERIFICADO na Resend, ex.: Sua Loja <pedidos@seudominio.com.br>
# Sem domínio verificado a Resend só entrega no e-mail do dono da conta.
RESEND_FROM_EMAIL=
# Para onde vão as respostas do cliente: a caixa da Hostinger atendimento@seudominio.com.br
RESEND_REPLY_TO=

# Painel /admin — mínimo de 12 caracteres.
ADMIN_PASSWORD=

# Assina o link único de rastreio que vai no e-mail. Qualquer string longa.
# ⚠️ Trocar depois invalida os links já enviados.
TRACKING_LINK_SECRET=

# Protege o Vercel Cron. A Vercel envia este valor sozinha no header.
CRON_SECRET=

# Protege POST /api/transportadora/evento (entrada dos eventos reais do pacote).
TRACKING_EVENTS_SECRET=

# (futuro) provedor de rastreio consultado pelo cron. Deixe vazio: a Sua Loja anda
# pelo relógio (SITE.relogio).
TRACKING_PROVIDER=
